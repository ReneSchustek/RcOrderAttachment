{% block rc_order_attachment_list %}
<mt-card
    class="rc-order-attachment-list"
    position-identifier="rc-order-attachment-list"
    :title="$t('rc-order-attachment.list.cardTitle')"
>
    {% block rc_order_attachment_list_empty %}
    <div
        v-if="!isLoading && (!attachments || attachments.length === 0)"
        class="rc-order-attachment-list__empty"
    >
        {{ $t('rc-order-attachment.list.empty') }}
    </div>
    {% endblock %}

    {% block rc_order_attachment_list_grid %}
    <sw-data-grid
        v-else
        class="rc-order-attachment-list__grid"
        :dataSource="attachments || []"
        :columns="columns"
        :isLoading="isLoading"
        :showSettings="false"
        :showSelection="false"
        :allowInlineEdit="false"
        :allowColumnEdit="false"
    >
        {% block rc_order_attachment_list_grid_column_size %}
        <template #column-fileSize="{ item }">
            {{ formatFileSize(item.fileSize) }}
        </template>
        {% endblock %}

        {% block rc_order_attachment_list_grid_column_uploaded %}
        <template #column-createdAt="{ item }">
            {{ dateFilter(item.createdAt) }}
        </template>
        {% endblock %}

        {% block rc_order_attachment_list_grid_actions %}
        <template #actions="{ item }">
            <sw-context-menu-item
                class="rc-order-attachment-list__download"
                :disabled="isDownloading(item.id)"
                @click="onDownload(item)"
            >
                {{ $t('rc-order-attachment.list.download') }}
            </sw-context-menu-item>
        </template>
        {% endblock %}
    </sw-data-grid>
    {% endblock %}
</mt-card>
{% endblock %}
